cat > .gitignore <<'EOF'
# Flutter/Dart
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
*.log

# Android
android/.gradle/
android/local.properties
**/key.properties
**/*.jks
**/*.keystore

# iOS/macOS (pods & ephemeral)
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
macos/Pods/
macos/Flutter/ephemeral/
EOF
