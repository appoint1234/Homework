<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcBtnBase">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">0dp</item>
    </style>

    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/bg_btn_num</item>
    </style>

    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:textColor">#111113</item>
        <item name="android:background">@drawable/bg_btn_func</item>
    </style>

    <style name="CalcBtnOp" parent="CalcBtnBase">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/bg_btn_op</item>
    </style>

    <style name="CalcBtnZero" parent="CalcBtnNum">
        <item name="android:layout_width">160dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">28dp</item>
    </style>
</resources>